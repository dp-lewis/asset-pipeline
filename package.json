{
  "name": "asset-pipeline",
  "version": "0.1.0",
  "description": "Concept art → turnarounds → 3D models. Drives OpenAI image generation and Tripo 3D from the command line, with a Claude skill on top.",
  "type": "module",
  "bin": {
    "asset": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "openai": "^7.62.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
