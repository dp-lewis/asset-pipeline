# Copy to .env (in this folder, or ~/.config/asset-pipeline/.env) and fill in.
OPENAI_API_KEY=sk-...
TRIPO_API_KEY=tsk_...

# Optional: Tripo's global endpoint is the default. Use https://openapi.tripo3d.com/v3 for the China region.
# TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3

# Optional: set to 1 to run everything with fake providers (no API calls, no cost).
# ASSET_PIPELINE_MOCK=1
